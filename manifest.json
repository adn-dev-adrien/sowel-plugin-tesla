{
  "id": "tesla",
  "type": "integration",
  "name": "Tesla",
  "version": "0.1.1",
  "description": "Tesla through the official Fleet API: battery, range, charging state and mileage, read only around charges to stay within the free monthly credit",
  "icon": "Car",
  "repo": "adn-dev-adrien/sowel-plugin-tesla",
  "author": "adn-dev-adrien",
  "sowelVersion": ">=1.79.0",
  "settings": [
    {
      "key": "client_id",
      "label": "Client ID de l'application Tesla (developer.tesla.com)",
      "type": "text",
      "required": true
    },
    {
      "key": "client_secret",
      "label": "Client Secret de l'application Tesla",
      "type": "password",
      "required": true
    },
    {
      "key": "domain",
      "label": "Domaine de ton Sowel, celui qui sert la clé publique Tesla",
      "type": "text",
      "required": true,
      "placeholder": "domotique.exemple.fr"
    },
    {
      "key": "charger_equipment_id",
      "label": "Identifiant de la borne (36 caractères, fin de l'adresse de sa page)",
      "type": "text",
      "required": false,
      "placeholder": "a1b2c3d4-…-…-…-…"
    },
    {
      "key": "monthly_cap",
      "label": "Plafond de requêtes facturées par mois",
      "type": "number",
      "required": false,
      "defaultValue": "1500"
    },
    {
      "key": "region",
      "label": "Région Tesla (eu ou na)",
      "type": "text",
      "required": false,
      "defaultValue": "eu",
      "placeholder": "eu"
    }
  ],
  "apiVersion": 2
}
